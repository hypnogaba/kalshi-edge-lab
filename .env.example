# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Kalshi DEMO (Step B: bot places demo orders) ---
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=secrets/kalshi_demo_key.pem
KALSHI_DEMO_API_BASE=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_DEMO_WS=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2

# --- Kalshi PROD read-only (Step A: latency race, market data only) ---
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=secrets/kalshi_prod_key.pem
KALSHI_PROD_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_PROD_WS=wss://api.elections.kalshi.com/trade-api/ws/v2

# --- Market ---
# Kalshi BTC = strike-ladder series (KXBTCD daily / KXBTC, KXBTC15M 15-min).
# There is no single "BTCPERP" market; pick a concrete active ticker at capture time.
KALSHI_MARKET=

# --- Binance reference (Step B) ---
BINANCE_WS=wss://fstream.binance.com/ws/btcusdt@bookTicker
