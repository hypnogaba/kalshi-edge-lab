# Copy to .env and fill in. .env is gitignored — never commit real values.

# Kalshi PROD read-only key — signs the public WebSocket handshake used as the
# latency-race baseline. Market data only; this project never trades.
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=secrets/kalshi_prod_key.pem
KALSHI_PROD_WS=wss://api.elections.kalshi.com/trade-api/ws/v2

# The perpetual to benchmark against the public feed (e.g. KXBTCPERP).
KALSHI_MARKET=KXBTCPERP
